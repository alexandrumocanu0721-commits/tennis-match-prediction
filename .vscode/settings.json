{
  "python.defaultInterpreterPath": "${workspaceFolder}/env/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.envFile": "${workspaceFolder}/.vscode/.env",
  "jupyter.jupyterServerType": "local",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.env.osx": {
    "JUPYTER_CONFIG_DIR": "${workspaceFolder}/.jupyter",
    "IPYTHONDIR": "${workspaceFolder}/.ipython",
    "MPLCONFIGDIR": "${workspaceFolder}/.matplotlib",
    "XDG_CACHE_HOME": "${workspaceFolder}/.cache",
    "PYTHONNOUSERSITE": "1"
  }
}
